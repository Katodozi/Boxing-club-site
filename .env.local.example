# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Single admin account
ADMIN_EMAIL=admin@ironbellboxing.com

# Generate this hash with: npm run seed:hash -- "your-password-here"
# The script prints a line ready to paste directly below — use that exact
# line, not the raw hash. Next.js expands unescaped $ in .env files, which
# silently corrupts bcrypt hashes (they're full of $). The script escapes
# them for you as \$.
ADMIN_PASSWORD_HASH=replace-with-generated-bcrypt-hash
